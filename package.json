  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "npm run build:site && vite --host 127.0.0.1 --port 1430 --strictPort dist-site",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && node scripts/build-site.mjs && node scripts/verify-site.mjs",
    "preview": "vite preview",
    "preview:site": "vite --host 127.0.0.1 --port 1430 --strictPort dist-site",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mvp": "node scripts/mvp-real-api.mjs",
    "test:mvp:plan2": "node scripts/plan2-real-regression.mjs",
    "prompts:import": "node scripts/aggregate-prompts.mjs",
    "prompts:import:legacy": "node scripts/import-prompts.mjs",
    "prompts:aggregate": "node scripts/aggregate-prompts.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@tauri-apps/api": "^2.11.1",
    "fabric": "^7.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "jsdom": "^27.0.1",
    "sharp": "^0.34.4",
    "typescript": "~5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
